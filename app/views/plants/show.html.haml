%style
  :plain
    .plant-show-placeholder {
      width: 100%;
      aspect-ratio: 4 / 3;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 96px;
      background: linear-gradient(135deg, #eaf6ec 0%, #d3ecd8 100%);
      margin-bottom: 16px;
    }
    .plant-info-block {
      border-radius: 6px;
      margin-bottom: 16px;
      overflow: hidden;
    }
    .plant-info-block-head {
      background: #046A38;
      color: #fff;
      padding: 8px 14px;
      font-weight: 700;
    }
    .plant-info-block-body {
      background: #DCEBC8;
      color: #223318;
      padding: 10px 14px;
    }
    .plant-info-block-body p {
      margin-bottom: 6px;
    }
    .plant-lbl {
      color: #4a6b3a;
      margin-right: 4px;
    }
    .plant-red-book-badge {
      display: inline-block;
      background: #c0392b;
      color: #fff;
      font-size: 12px;
      padding: 3px 10px;
      border-radius: 10px;
      margin-bottom: 12px;
    }
    /* Jamoaviy aniqlash orqali "ilmiy tadqiqotlar uchun" belgilangan
       kuzatuvlar — Qizil kitob nishoni bilan bir xil uslub, lekin ko'k
       rangda (ikkalasi shu sahifada aralashib qolmasin). */
    .plant-photo-research-grade {
      display: inline-block;
      background: #0b5394;
      color: #fff;
      font-size: 10px;
      padding: 2px 7px;
      border-radius: 8px;
      margin-bottom: 4px;
    }
    /* 💬 tugmasi — bosilganda izoh tor kartochka ICHIDA emas, umumiy
       MODAL oynada ochiladi (plant_sightings/_comment_modal_trigger.html.haml
       + _comment_modal.html.haml, bir marta shu sahifada render qilinadi). */
    .plant-photo-card .sighting-comment-modal-trigger {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      margin-top: 2px;
      padding: 0;
      border: none;
      background: none;
      color: #4a6b3a;
      font-size: 11px;
      font-weight: 600;
      cursor: pointer;
    }
    .plant-photo-card .sighting-comment-modal-trigger:hover,
    .plant-photo-card .sighting-comment-modal-trigger:focus {
      color: #046A38;
    }
    .plant-photo-card .sighting-comment-modal-trigger .sighting-action-icon {
      width: 13px;
      height: 13px;
      pointer-events: none;
    }
    /* Primary BO'LMAGAN (POWO orqali boshqa turga birlashtirilgan)
       yozuv sahifasidagi eslatma — .plant-info-block bilan bir xil
       yashil palitra, lekin OGOHLANTIRISH emas, shunchaki INFORMATIV
       bo'lgani uchun to'liq blok emas, ingichka chiziqli banner. */
    .plant-merged-notice {
      background: #DCEBC8;
      border: 1px solid #046A38;
      border-radius: 6px;
      padding: 10px 14px;
      margin-bottom: 16px;
      color: #223318;
    }
    .plant-merged-notice a {
      color: #046A38;
      font-weight: 700;
    }
    .plant-taxonomy-table {
      width: 100%;
      table-layout: fixed;
    }
    .plant-taxonomy-table td {
      padding: 3px 0;
      vertical-align: top;
      word-wrap: break-word;
      overflow-wrap: break-word;
    }
    .plant-taxonomy-table td.plant-lbl {
      width: 90px;
      white-space: nowrap;
      padding-right: 8px;
    }
    /* Foydalanuvchi rasmlari galereyasi — bosh sahifadagi rasm
       kartochkalari (welcome-gallery) bilan bir xil vizual uslub
       (yumaloq burchak, soya). UCH USTUNLI grid ish stoli/planshetda
       (avval ikki ustun edi, Bobur uch ustun qulayroq deb hisobladi).
       480px dan tor ekranlarda (mobil) IKKI ustunga tushadi — bitta
       ustunga EMAS: bitta ustunda rasm butun ekran enini egallab, juda
       katta bo'lib ko'rinardi (avvalgi holat). Ikki ustunda ham kartochka
       ~150-170px, uch ustunli ish stoli bilan deyarli bir xil o'lchamda
       — shu sabab pastda alohida "mobil uchun kichikroq matn" qoidasi
       shart emas, bitta o'lcham ikkalasiga ham mos keladi. */
    .plant-photos-title {
      color: #2f4a1c !important;
      margin-bottom: 12px;
    }
    .plant-photos-gallery {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 8px;
    }
    @media (max-width: 480px) {
      .plant-photos-gallery {
        grid-template-columns: 1fr 1fr;
      }
    }
    .plant-photo-card {
      border-radius: 8px;
      overflow: hidden;
      background: #fff;
      box-shadow: 0 2px 10px rgba(0,0,0,.08);
    }
    .plant-photo-img {
      width: 100%;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      display: block;
    }
    .plant-photo-meta {
      padding: 4px 6px;
    }
    .plant-photo-meta p {
      margin-bottom: 2px;
      font-size: 10px;
      line-height: 1.3;
      color: #666;
    }
    /* Sana va muallif odatda qisqa — bitta qatorda, toshib ketsa "..."
       bilan kesiladi. Joy/koordinata (address_string — manzil topilmasa
       "41.311081; 69.279737" kabi UZUN raqamlar qatoriga tushib qoladi,
       Plant#address_string'ga qarang) esa BITTA qatorga sig'maydi —
       shuning uchun alohida, 2 QATORGACHA bo'linishga ruxsat beriladi
       (-webkit-line-clamp — CSS-line-clamp'ning keng qo'llab-quvvatlanadigan
       varianti), undan uzun bo'lsa "..." bilan kesiladi. Ikkalasi ham
       kartochkadan HECH QACHON toshib chiqmaydi. */
    .plant-photo-date,
    .plant-photo-author {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .plant-photo-place {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .plant-photo-author a {
      color: #1e5620;
    }
    /* Guruh a'zosidan (POWO orqali shu turga birlashtirilgan boshqa
       yozuvdan) kelgan rasm ostidagi izoh — qaysi nom ostida kiritilgani.
       Boshqa meta qatorlar bilan bir xil kichik, xira uslub. */
    .plant-photo-submitted-as {
      font-style: italic;
      color: #888;
    }
    .plant-photos-empty {
      color: #888;
      font-style: italic;
    }
    .plant-photos-pagination {
      margin-top: 10px;
      text-align: center;
    }
    .plant-external-links {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }
    .plant-external-link-btn {
      display: inline-flex;
      align-items: center;
      padding: 6px;
      border-radius: 20px;
      border: 1px solid #046A38;
      background: #DCEBC8;
      text-decoration: none;
      transition: background-color .15s ease, border-color .15s ease;
    }
    .plant-external-link-btn:hover,
    .plant-external-link-btn:focus {
      background: #046A38;
      text-decoration: none;
    }
    .plant-external-link-logo {
      display: inline-flex;
      align-items: center;
      background: #fff;
      border-radius: 14px;
      padding: 5px 12px;
    }
    .plant-external-link-logo img {
      display: block;
      height: 22px;
      width: auto;
      max-width: 175px;
      object-fit: contain;
    }

= render 'plant_sightings/comment_modal'

.bg-btm-container
  .container.content
    - plant_scope = 'plants.show'
    .row.mtop20.mbtm20.content-container
      = link_to I18n.t('.back_to_list', scope: plant_scope), plants_path, class: 'btn btn-default mbtm20'

      .col.col-md-8.col-sm-12
        - if @primary_sibling.present?
          .plant-merged-notice= plant_merged_notice(@plant, @primary_sibling, plant_scope)

        - if @plant.red_book?
          .plant-red-book-badge= I18n.t('.red_book_badge', scope: plant_scope)

        %h3= plant_display_name_html(@plant, I18n.locale)
        - plant_name_rows(@plant, I18n.locale).each do |label_key, value|
          %p
            %span.plant-lbl= I18n.t(".#{label_key}", scope: plant_scope)
            = value
          - if label_key == :name_lat && @plant.alt_name.present?
            %p
              %span.plant-lbl= I18n.t(".#{@plant.alt_name_label_key}", scope: plant_scope)
              = sci_name_html(@plant.alt_name)

        - taxonomy_rows = plant_taxonomy_rows(@plant)
        - if taxonomy_rows.any?
          .plant-info-block
            .plant-info-block-head= I18n.t('.taxonomy', scope: plant_scope)
            .plant-info-block-body
              %table.plant-taxonomy-table
                - taxonomy_rows.each do |label_key, lat|
                  %tr
                    %td.plant-lbl= I18n.t(".taxon_#{label_key}", scope: plant_scope)
                    %td= lat

        - if @group_siblings.present?
          .plant-info-block
            .plant-info-block-head= I18n.t('.other_names_title', scope: plant_scope)
            .plant-info-block-body
              - @group_siblings.each do |sibling|
                %p= link_to (sibling.species_uz.presence ? capitalize_first(sibling.species_uz) : plant_sci_name_html(sibling)), plant_path(sibling)

        - life_form_text = capitalize_first(@plant.life_form_localized(I18n.locale))
        - if life_form_text.present?
          .plant-info-block
            .plant-info-block-head= I18n.t('.life_form', scope: plant_scope)
            .plant-info-block-body
              %p= life_form_text

        - habitat_env_text = capitalize_first(@plant.habitat_env_localized(I18n.locale))
        - habitat_place_text = capitalize_first(@plant.habitat_place_localized(I18n.locale))
        - if habitat_env_text.present? || habitat_place_text.present?
          .plant-info-block
            .plant-info-block-head= I18n.t('.habitat', scope: plant_scope)
            .plant-info-block-body
              - if habitat_env_text.present?
                %p
                  %span.plant-lbl= I18n.t('.habitat_env', scope: plant_scope)
                  = habitat_env_text
              - if habitat_place_text.present?
                %p
                  %span.plant-lbl= I18n.t('.habitat_place', scope: plant_scope)
                  = habitat_place_text

        - usage_text = capitalize_first(@plant.usage_localized(I18n.locale))
        - if usage_text.present?
          .plant-info-block
            .plant-info-block-head= I18n.t('.usage', scope: plant_scope)
            .plant-info-block-body
              %p= usage_text

        - range_world_text = capitalize_first(@plant.range_world_localized(I18n.locale))
        - range_central_asia_text = capitalize_first(@plant.range_central_asia_localized(I18n.locale))
        - range_uzbekistan_text = capitalize_first(@plant.range_uzbekistan_localized(I18n.locale))
        - if range_world_text.present? || range_central_asia_text.present? || range_uzbekistan_text.present?
          .plant-info-block
            .plant-info-block-head= I18n.t('.range', scope: plant_scope)
            .plant-info-block-body
              - if range_world_text.present?
                %p
                  %span.plant-lbl= I18n.t('.range_world', scope: plant_scope)
                  = range_world_text
              - if range_central_asia_text.present?
                %p
                  %span.plant-lbl= I18n.t('.range_central_asia', scope: plant_scope)
                  = range_central_asia_text
              - if range_uzbekistan_text.present?
                %p
                  %span.plant-lbl= I18n.t('.range_uzbekistan', scope: plant_scope)
                  = range_uzbekistan_text

        - if @plant.protected_areas.present?
          .plant-info-block
            .plant-info-block-head= I18n.t('.protected_areas', scope: plant_scope)
            .plant-info-block-body
              %p= @plant.protected_areas

        - external_links = plant_external_links(@plant)
        - if external_links.any?
          .plant-info-block
            .plant-info-block-head= I18n.t('.external_sources', scope: plant_scope)
            .plant-info-block-body
              .plant-external-links
                - external_links.each do |key, label, logo_path, url|
                  = link_to url, target: '_blank', rel: 'noopener noreferrer', class: "plant-external-link-btn plant-external-link-#{key}" do
                    %span.plant-external-link-logo
                      = image_tag logo_path, alt: label

      .col-sm-12.col.col-md-4.fright.m-no-float
        - if @sightings.total_count.positive?
          %h4.plant-photos-title= I18n.t('.photos_title', scope: plant_scope)
          .plant-photos-gallery
            - @sightings.each do |sighting|
              .plant-photo-card
                = link_to plant_sighting_path(sighting) do
                  = plant_sighting_photo_tag(sighting, :small, class: 'plant-photo-img')
                .plant-photo-meta
                  - if sighting.research_grade?
                    .plant-photo-research-grade= I18n.t('research_grade_badge', scope: 'identifications')
                  - if sighting.timestamp.present?
                    %p.plant-photo-date= date_format(sighting.timestamp)
                  - if sighting.address_valid?
                    %p.plant-photo-place= plant_sighting_location(sighting)
                  %p.plant-photo-author
                    = I18n.t('.photo_by', scope: plant_scope)
                    = link_to sighting.user.full_name, profile_path(sighting.user)
                  - if sighting.plant_id != @plant.id
                    %p.plant-photo-submitted-as= t('photo_submitted_as_html', scope: plant_scope, name: sci_name_html(sighting.plant.species_sci))
                  = render 'plant_sightings/comment_modal_trigger', plant_sighting: sighting
          - if @sightings.total_pages > 1
            .plant-photos-pagination
              = paginate @sightings, param_name: :sightings_page
        - else
          .plant-show-placeholder 🌿
          %p.plant-photos-empty.acenter= I18n.t('.photos_empty', scope: plant_scope)
