%style
  :plain
    .plant-placeholder {
      width: 100%;
      aspect-ratio: 4 / 3;
      border-radius: 6px 6px 0 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 48px;
      background: linear-gradient(135deg, #eaf6ec 0%, #d3ecd8 100%);
    }
    /* Tasdiqlangan rasm bor kartochkalar uchun — bir nechta rasm bo'lsa,
       JS (plants_index.js) har 3.5 soniyada .active klassni navbatdagi
       rasmga o'tkazadi, CSS esa faqat opacity orqali ohista fade qiladi
       (og'ir kutubxonasiz, sof CSS transition). */
    .plant-card-photo {
      position: relative;
      width: 100%;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      border-radius: 6px 6px 0 0;
      background: #eee;
    }
    .plant-card-photo-img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      transition: opacity .6s ease-in-out;
    }
    .plant-card-photo-img.active {
      opacity: 1;
    }
    /* Bootstrap 3 grid'i float asosida ishlaydi — kartochkalar bir
       qatorda har xil balandlikda bo'lsa (masalan Qizil kitob belgisi
       yoki ikki qatorli nom bor/yo'q), keyingi qator eng baland
       kartochkaga "ilishib" qolib, tartibsiz bo'sh joy hosil bo'ladi.
       Yechim: qatorni (.plants-grid-row) flexbox qilamiz — shunda har
       bir "qator" (flex-wrap orqali hosil bo'lgan qatlam) o'z ichida
       avtomatik teng balandlikka cho'ziladi (align-items:stretch,
       standart qiymat), JS yoki qo'lda balandlik hisoblash shart emas.
       Bu FAQAT shu grid qatoriga tegishli — boshqa .row'lar (filtr
       formasi va h.k.) o'zgarmaydi. */
    .plants-grid-row {
      display: flex;
      flex-wrap: wrap;
    }
    /* Flex konteynerda .col-sm-6/.col-md-3'ning o'z width qoidalari
       (Bootstrap'ning min-width:768px/992px media so'rovlari ichida)
       ishlayveradi — lekin flex item sifatida ular endi "auto"
       (kontentga qarab torayishi) emas, aniq width'ga muhtoj, aks
       holda mobilda (768px'dan pastda, col-sm-6 hali ishlamay turgan
       oraliqda) kartochkalar to'liq kenglikka cho'zilmay, tor holda
       yonma-yon qisilib qolar edi. Shu uchun Bootstrap'ning o'zi
       ishlatadigan xuddi shu breakpointlarda width qayta beriladi. */
    .plants-grid-col {
      display: flex;
      width: 100%;
    }
    @media (min-width: 768px) {
      .plants-grid-col {
        width: 50%;
      }
    }
    @media (min-width: 992px) {
      .plants-grid-col {
        width: 25%;
      }
    }
    .plant-card {
      display: flex;
      flex-direction: column;
      width: 100%;
      border: 1px solid #e2e2e2;
      border-radius: 6px;
      margin-bottom: 20px;
      overflow: hidden;
      background: #fff;
      transition: box-shadow .15s ease-in-out;
    }
    .plant-card:hover {
      box-shadow: 0 2px 10px rgba(0,0,0,.12);
    }
    .plant-card-body {
      display: flex;
      flex-direction: column;
      flex: 1 1 auto;
      padding: 12px 14px;
    }
    .plant-card-name-uz {
      font-weight: 600;
      margin-bottom: 2px;
    }
    .plant-card-name-sci {
      font-style: italic;
      color: #777;
      font-size: 13px;
      margin-bottom: 4px;
    }
    .plant-card-family {
      font-size: 12px;
      color: #999;
    }
    .plant-red-book-badge {
      display: inline-block;
      background: #c0392b;
      color: #fff;
      font-size: 11px;
      padding: 2px 7px;
      border-radius: 10px;
      margin-top: 6px;
    }
    /* MOBIL (767px va pastda) — o'simliklar ro'yxati iNaturalist
       uslubidagi ixcham 3 ustunli grid'ga aylanadi (avval 1 ustun edi).
       Planshet (768px+, .plants-grid-col{width:50%}) va desktop (992px+,
       width:25%) — yuqoridagi mavjud qoidalar bilan O'ZGARISHSIZ qoladi,
       bu blok faqat max-width:767px'da ishlaydi. Bootstrap'ning
       col-sm-6/col-md-3 klasslaridan kelayotgan 15px gutter (padding/
       .row margin) shu diapazonda kichikroqqa (4px) almashtiriladi —
       aks holda 3 ustunda kartalar orasidagi bo'shliq nomutanosib katta
       bo'lib qolar edi. */
    @media (max-width: 767px) {
      .plants-grid-row {
        margin-left: -4px;
        margin-right: -4px;
      }
      .plants-grid-col {
        width: 33.333%;
        padding-left: 4px;
        padding-right: 4px;
      }
      .plant-card {
        margin-bottom: 8px;
        border-radius: 4px;
      }
      .plant-card-body {
        padding: 6px 7px;
      }
      .plant-card-name-uz {
        font-size: 12px;
        line-height: 1.25;
        margin-bottom: 1px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .plant-card-name-sci {
        font-size: 10px;
        margin-bottom: 2px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .plant-card-family {
        font-size: 10px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .plant-red-book-badge {
        font-size: 9px;
        padding: 1px 5px;
        margin-top: 3px;
      }
      /* Navbar (60px, fixed) bilan sarlavha orasidagi bo'shliq mobilda
         haddan tashqari katta ko'rinardi (.content'ning global
         padding-top:60px + shu qatorning umumiy .mtop20 (20px) =
         80px). Global `.content`/`.mtop20` boshqa BARCHA sahifalarda
         ham ishlatilgani uchun ularga tegilmaydi — faqat shu sahifaga
         xos qatorning o'z margin-top'i mobilda kichraytiriladi.
         Desktop/planshet — o'zgarishsiz (mtop20 saqlanadi). */
      .plants-index-header-row {
        margin-top: 8px !important;
      }
    }
    .plants-filter-form {
      margin-bottom: 24px;
    }
    .plants-index-title {
      font-family: 'Samsung Sharp Sans', 'Manrope', Arial, sans-serif !important;
      font-weight: 700;
    }
    /* Qidiruv (matn) va oila (dropdown) yacheykalari — sayt uslubiga mos
       emerald/pistachio chegara, yumaloq burchak, yumshoq soya, ikkalasi
       bir xil balandlik/uslub (avval to'q ko'k #1a237e chegara edi, sayt
       palitrasiga mos emas edi). */
    .plants-filter-form .form-control {
      background-color: #fff;
      border: 1.5px solid #b9d69e;
      border-radius: 10px;
      height: 42px;
      padding: 8px 14px;
      box-shadow: 0 1px 3px rgba(0,0,0,.05);
      transition: border-color .15s ease, box-shadow .15s ease;
    }
    .plants-filter-form .form-control:focus {
      border-color: #046A38;
      box-shadow: 0 0 0 3px rgba(4,106,56,.14);
      outline: none;
    }
    /* Qidiruv maydoni ichida chapда lupa belgisi — input BO'SH bo'lganda
       (placeholder ko'rinib turganda) ko'rinadi, foydalanuvchi yoza
       boshlashi bilan (`:placeholder-shown` endi mos kelmay qoladi)
       yashiriladi — JS shart emas, sof CSS. Bu klasslar FAQAT shu
       sahifaga xos (`.plants-index-search`) — `.plant-autocomplete`/
       `.plant-autocomplete-input`ning o'zi boshqa sahifalarda ham
       (wizard, moderatsiya) ishlatiladi, ularga tegilmaydi. */
    .plants-index-search .plant-autocomplete-input {
      padding-left: 36px !important;
    }
    .plants-index-search-icon {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 14px;
      color: #6b8f5a;
      pointer-events: none;
      transition: opacity .15s ease;
    }
    .plants-index-search .plant-autocomplete-input:not(:placeholder-shown) ~ .plants-index-search-icon {
      opacity: 0;
    }
    .plants-search-btn {
      background-color: #c62828 !important;
      border-color: #b71c1c !important;
      color: #fff !important;
      &:hover, &:focus {
        background-color: #b71c1c !important;
        border-color: #8e0000 !important;
      }
    }
    /* Rasm orqali o'simlik aniqlash (PlantNet) bo'limi — sahifa uslubiga
       mos emerald/pistachio (plants/show'даgi .plant-info-block bilan
       bir xil palitra). Tepadagi katta 📷 ikonka olib tashlandi (faqat
       pastdagi "Rasmga olish" tugmasidagi kichik ikonka qoladi) —
       shuning uchun bo'lim endi flex-row emas (bitta bola qoldi). */
    .plant-identify-card {
      background: #DCEBC8;
      border: 1px solid #b9d69e;
      border-radius: 8px;
      padding: 16px 18px;
      margin-bottom: 20px;
    }
    .plant-identify-body {
      min-width: 0;
    }
    .plant-identify-title {
      color: #223318;
      font-weight: 700;
      margin-bottom: 2px;
    }
    .plant-identify-subtitle {
      color: #4a6b3a;
      font-size: 13px;
      margin-bottom: 10px;
    }
    /* Ikkita tugma ("Rasmga olish" — kamera, va "Rasm tanlash" —
       galereya) — yonma-yon, tor ekranda ikkinchi qatorga o'tishi
       mumkin (flex-wrap). */
    .plant-identify-btn-row {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }
    .plant-identify-choose-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #046A38;
      color: #fff;
      padding: 8px 16px;
      border-radius: 20px;
      font-weight: 600;
      cursor: pointer;
      border: none;
    }
    .plant-identify-choose-btn:hover,
    .plant-identify-choose-btn:focus {
      background: #035129;
      color: #fff;
    }
    .plant-identify-file-input {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      opacity: 0;
    }
    .plant-identify-status {
      margin-top: 12px;
      color: #4a6b3a;
      font-weight: 600;
    }
    .plant-identify-results {
      margin-top: 12px;
    }
    .plant-identify-error,
    .plant-identify-empty {
      color: #7a3b1e;
    }
    .plant-identify-disclaimer {
      font-size: 12px;
      color: #4a6b3a;
      font-style: italic;
      margin-bottom: 10px;
    }
    .plant-identify-prediction {
      background: #fff;
      border-radius: 6px;
      padding: 10px 12px;
      margin-bottom: 8px;
    }
    .plant-identify-prediction-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 10px;
    }
    .plant-identify-prediction-name {
      font-weight: 600;
      color: #223318;
    }
    .plant-identify-prediction-score {
      color: #046A38;
      font-weight: 700;
      white-space: nowrap;
    }
    .plant-identify-prediction-common {
      color: #666;
      font-size: 13px;
      margin: 2px 0 6px;
    }
    .plant-identify-score-bar {
      background: #eaf1e2;
      border-radius: 4px;
      height: 6px;
      overflow: hidden;
      margin-bottom: 6px;
    }
    .plant-identify-score-bar-fill {
      background: #046A38;
      height: 100%;
    }
    .plant-identify-profile-link {
      font-size: 13px;
      font-weight: 600;
    }
    @media (max-width: 480px) {
      .plant-identify-prediction-row {
        flex-direction: column;
        gap: 2px;
      }
    }

.bg-btm-container
  .container.content
    - plants_scope = 'plants.index'
    .row.mtop20.mbtm20.content-container.plants-index-header-row
      .col.col-md-12.col-sm-12
        %h3.plants-index-title= I18n.t('.title', scope: plants_scope)

        .plant-identify-card
          .plant-identify-body
            .plant-identify-title= I18n.t('title', scope: 'plants.index.identify')
            .plant-identify-subtitle= I18n.t('subtitle', scope: 'plants.index.identify')
            = form_tag identify_plants_path, multipart: true, id: 'plant-identify-form' do
              .plant-identify-btn-row
                %label.plant-identify-choose-btn{ for: 'plant-identify-camera-file' }
                  📷
                  = I18n.t('take_photo', scope: 'plants.index.identify')
                = file_field_tag :image, accept: 'image/*', capture: 'environment', id: 'plant-identify-camera-file', class: 'plant-identify-file-input'
                %label.plant-identify-choose-btn{ for: 'plant-identify-file' }
                  = I18n.t('choose_photo', scope: 'plants.index.identify')
                = file_field_tag :image, accept: 'image/*', id: 'plant-identify-file', class: 'plant-identify-file-input'
            .plant-identify-status{ style: 'display:none;' }= I18n.t('loading', scope: 'plants.index.identify')
            #plant-identify-results.plant-identify-results{ data: { error_generic: I18n.t('generic', scope: 'plants.index.identify.errors') } }

        .row.plants-filter-form
          = form_tag plants_path, method: :get, class: 'form-inline' do
            .form-group.mright10
              .plant-autocomplete.plants-index-search{ data: { url: plant_sightings_autocomplete_path, not_found: I18n.t('.not_found', scope: plants_scope), auto_submit: true } }
                = text_field_tag :q, params[:q], class: 'form-control plant-autocomplete-input', placeholder: I18n.t('.search_placeholder', scope: plants_scope), autocomplete: 'off'
                %span.plants-index-search-icon 🔍
                %ul.plant-autocomplete-list
            .form-group.mright10
              = select_tag :family, options_for_select(@families, params[:family]), include_blank: I18n.t('.all_families', scope: plants_scope), class: 'form-control'
            .form-group.mright10
              %label
                = check_box_tag :red_book, '1', params[:red_book].present?
                = I18n.t('.red_book_only', scope: plants_scope)
            = submit_tag I18n.t('.search', scope: plants_scope), class: 'btn plants-search-btn'
            - if params[:q].present? || params[:family].present? || params[:red_book].present?
              = link_to I18n.t('.clear', scope: plants_scope), plants_path, class: 'btn btn-default'

        %p.mbtm20
          = I18n.t('.total', scope: plants_scope, count: @plants.total_count)

        .row.plants-grid-row
          - @plants.each do |plant|
            .col-sm-6.col-md-3.plants-grid-col
              .plant-card
                = link_to plant_path(plant) do
                  - plant_sightings = @sightings_by_plant[plant.id]
                  - if plant_sightings.present?
                    .plant-card-photo
                      - plant_sightings.first(5).each_with_index do |sighting, i|
                        = image_tag sighting.photo.small.url, class: "plant-card-photo-img #{'active' if i.zero?}"
                  - else
                    .plant-placeholder 🌿
                .plant-card-body
                  = link_to plant_path(plant), class: 'plant-card-link' do
                    .plant-card-name-uz= plant.display_name(I18n.locale)
                    .plant-card-name-sci= plant.display_sci_name
                  - if plant.display_family_lat.present?
                    .plant-card-family= plant.display_family_lat
                  - if plant.red_book?
                    .plant-red-book-badge= I18n.t('.red_book_badge', scope: plants_scope)

        .row.acenter
          = paginate @plants
