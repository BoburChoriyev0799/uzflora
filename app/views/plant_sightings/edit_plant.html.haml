%style
  :plain
    .sighting-identify-row {
      margin-bottom: 20px;
    }
    .sighting-identify-btn {
      display: inline-block;
      background: #046A38;
      color: #fff;
      padding: 8px 16px;
      border-radius: 20px;
      font-weight: 600;
      border: none;
      cursor: pointer;
    }
    .sighting-identify-btn:hover,
    .sighting-identify-btn:focus {
      background: #035129;
      color: #fff;
    }
    .sighting-identify-btn:disabled {
      background: #9bb89b;
      cursor: default;
    }
    .sighting-identify-not-ready {
      font-style: italic;
    }
    .sighting-identify-status {
      margin-top: 10px;
      color: #4a6b3a;
      font-weight: 600;
    }
    .sighting-identify-results {
      margin-top: 10px;
    }
    .sighting-identify-error,
    .sighting-identify-empty {
      color: #7a3b1e;
    }
    .sighting-identify-disclaimer {
      font-size: 12px;
      color: #4a6b3a;
      font-style: italic;
      margin-bottom: 10px;
    }
    .sighting-identify-prediction {
      background: #DCEBC8;
      border-radius: 6px;
      padding: 10px 12px;
      margin-bottom: 8px;
    }
    .sighting-identify-prediction-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 10px;
    }
    .sighting-identify-prediction-name {
      font-weight: 600;
      color: #223318;
    }
    .sighting-identify-prediction-score {
      color: #046A38;
      font-weight: 700;
      white-space: nowrap;
    }
    .sighting-identify-prediction-common {
      color: #666;
      font-size: 13px;
      margin: 2px 0 6px;
    }
    .sighting-identify-score-bar {
      background: #fff;
      border-radius: 4px;
      height: 6px;
      overflow: hidden;
      margin-bottom: 8px;
    }
    .sighting-identify-score-bar-fill {
      background: #046A38;
      height: 100%;
    }
    .sighting-identify-prediction-actions {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .sighting-identify-select-btn {
      background: #fff;
      border: 1px solid #046A38;
      color: #046A38;
      border-radius: 14px;
      padding: 4px 12px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
    }
    .sighting-identify-select-btn:hover,
    .sighting-identify-select-btn:focus {
      background: #046A38;
      color: #fff;
    }
    .sighting-identify-profile-link {
      font-size: 13px;
      font-weight: 600;
    }
    @media (max-width: 480px) {
      .sighting-identify-prediction-row {
        flex-direction: column;
        gap: 2px;
      }
      .sighting-identify-prediction-actions {
        flex-direction: column;
        align-items: flex-start;
        gap: 6px;
      }
    }

.bg-btm-container
  .container.content
    - edit_scope = 'plant_sightings.edit'
    .row.mtop20
      %h3.acenter= I18n.t('.title', scope: edit_scope)
      = render 'steps', current_step: :plant

    .row.mtop40.add-photo-container.add-plant-container
      .col-md-9.col-sm-12
        .form-container
          .row.mbtm20
            .col-md-9.col-sm-12
              %span= I18n.t('.plant_label', scope: edit_scope)
              %span.selected-plant= I18n.t('.unknown_plant', scope: edit_scope)

          .row.sighting-identify-row
            .col-md-9.col-sm-12
              - if @plant_sighting.photo_status_ready?
                %button.sighting-identify-btn#sighting-identify-btn{ type: 'button', data: { url: identify_plant_sighting_path(@plant_sighting) } }
                  🔍
                  = I18n.t('button', scope: 'plant_sightings.edit.identify')
              - elsif @plant_sighting.photo_status_failed?
                %p.text-muted.sighting-identify-not-ready= I18n.t('plant_sightings.photo_failed')
              - else
                %p.text-muted.sighting-identify-not-ready= I18n.t('not_ready', scope: 'plant_sightings.edit.identify.errors')
              .sighting-identify-status{ style: 'display:none;' }= I18n.t('loading', scope: 'plant_sightings.edit.identify')
              #sighting-identify-results.sighting-identify-results{ data: { error_generic: I18n.t('generic', scope: 'plants.index.identify.errors') } }

          = form_tag plant_sightings_search_path, method: :post, remote: true do
            .plant-autocomplete.w80.sm-width-max{ data: { url: plant_sightings_autocomplete_path, not_found: I18n.t('.not_found', scope: edit_scope) } }
              = text_field_tag :text, nil, class: 'form-control plant-autocomplete-input', autofocus: true, autocomplete: 'off', placeholder: I18n.t('.plant_name_placeholder', scope: edit_scope)
              %ul.plant-autocomplete-list
            = submit_tag I18n.t('.find', scope: edit_scope), class: 'btn btn-success fright sm-center sm-mtop10 w15 m-mtop20 sm-width-max'
            .search-description
              = I18n.t('.howto_find_plant', scope: edit_scope)

          .row.search-results.mtop20.m-mbtm20.pleft20

          = form_for @plant_sighting, url: publish_plant_sighting_path(@plant_sighting), method: :post do |form|
            = form.hidden_field :plant_id
            .row.mtop20
              %p= I18n.t('.note_label', scope: edit_scope)
              = form.text_area :note, class: 'form-control', maxlength: 100
              %p.text-muted= I18n.t('.note_hint', scope: edit_scope)
            = form.submit I18n.t('.publish', scope: edit_scope), class: 'fright btn btn-info mtop20 sm-display-none'
            = form.submit I18n.t('.publish', scope: edit_scope), class: 'mtop3 m-h35 mbtm20 sm-width-max btn btn-info display-sm-only w'

      .col-md-3.acenter.sm-display-none
        = render 'sighting_info', sighting: @plant_sighting
