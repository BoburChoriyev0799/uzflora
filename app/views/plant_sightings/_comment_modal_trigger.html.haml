- show_scope = 'plant_sightings.show'
- target_id = "sighting-comment-modal-content-#{plant_sighting.id}"
%button.sighting-action-btn.sighting-comment-modal-trigger{type: 'button', data: {target: target_id}}
  %svg.sighting-action-icon{xmlns: 'http://www.w3.org/2000/svg', viewBox: '0 0 24 24', fill: 'none', stroke: 'currentColor', 'stroke-width' => '2', 'stroke-linecap' => 'round', 'stroke-linejoin' => 'round'}
    %path{d: 'M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z'}
  %span.sighting-comment-count{data: {plant_sighting_id: plant_sighting.id}}= plant_sighting.comments_count

.sighting-comment-modal-content{id: target_id, style: 'display:none;'}
  - if plant_sighting[:photo].present?
    .sighting-comment-modal-photo
      = plant_sighting_photo_tag(plant_sighting, :original, class: 'sighting-comment-modal-img')
  .sighting-comment-modal-info
    %p.sighting-comment-modal-plant
      - if plant_sighting.plant.present?
        = link_to plant_sighting.plant.display_name(I18n.locale), plant_path(plant_sighting.plant)
      - else
        = I18n.t('.unknown_plant', scope: show_scope)
    - if plant_sighting.timestamp.present?
      %p.sighting-comment-modal-date= date_format(plant_sighting.timestamp)
  .sighting-comment-modal-comments.sighting-comments-block{data: {plant_sighting_id: plant_sighting.id}}
    = render 'plant_sightings/comments', plant_sighting: plant_sighting
