%style
  :plain
    .moderation-list {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
    }
    .moderation-card {
      background: #fff;
      border: 1px solid #dfe9d0;
      border-radius: 8px;
      box-shadow: 0 2px 12px rgba(0,0,0,.06);
      width: 100%;
      max-width: 320px;
      overflow: hidden;
    }
    .moderation-card-photo img {
      width: 100%;
      display: block;
    }
    .moderation-card-body {
      padding: 14px 16px;
    }
    .moderation-meta {
      margin-bottom: 6px;
      font-size: 14px;
    }
    .moderation-meta .lbl {
      font-weight: 600;
      margin-right: 4px;
    }
    .moderation-note {
      font-style: italic;
      color: #555;
      margin-bottom: 10px;
    }
    .moderation-actions {
      display: flex;
      gap: 10px;
      margin-top: 12px;
    }
    .moderation-actions .btn {
      flex: 1;
    }
    .moderation-actions .btn[disabled] {
      opacity: .5;
      cursor: not-allowed;
    }
    .moderation-plant-assign {
      margin-bottom: 10px;
    }
    .moderation-plant-label {
      display: block;
      font-weight: 600;
      font-size: 13px;
      margin-bottom: 4px;
    }
    .moderation-plant-autocomplete {
      display: block;
      width: 100%;
    }
    .moderation-plant-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 6px;
    }
    .moderation-assign-plant[disabled] {
      opacity: .5;
      cursor: not-allowed;
    }
    .moderation-assign-feedback {
      font-size: 12px;
      color: #5a8f3c;
    }
    .moderation-plant-warning {
      color: #a94442;
      font-size: 13px;
      margin: 6px 0 0;
    }
    @media (max-width: 480px) {
      .moderation-card {
        max-width: 100%;
      }
    }

.bg-btm-container
  .container.content
    - pending_scope = 'plant_sightings.pending'
    .row.mtop40
      %h3.acenter= I18n.t('.title', scope: pending_scope)

    - if @plant_sightings.empty?
      .row.mtop40.acenter#moderation-empty
        %p= I18n.t('.empty', scope: pending_scope)
    - else
      .row.moderation-list.mtop30{data: {plant_required_warning: I18n.t('.plant_required_warning', scope: pending_scope)}}
        - @plant_sightings.each do |sighting|
          .moderation-card{id: "sighting-#{sighting.id}"}
            .moderation-card-photo
              = link_to plant_sighting_path(sighting), target: '_blank' do
                = plant_sighting_photo_tag(sighting, :small)

            .moderation-card-body
              .moderation-plant-assign
                %label.moderation-plant-label{for: "plant_query_#{sighting.id}"}= I18n.t('.plant_label', scope: pending_scope)
                .plant-autocomplete.moderation-plant-autocomplete{data: {url: plant_sightings_autocomplete_path, not_found: I18n.t('.not_found', scope: pending_scope)}}
                  = text_field_tag "plant_query_#{sighting.id}", (sighting.plant.present? ? "#{sighting.plant.display_name(I18n.locale)} | #{sighting.plant.species_sci}" : nil), class: 'form-control plant-autocomplete-input', autocomplete: 'off', placeholder: I18n.t('.plant_name_placeholder', scope: pending_scope)
                  %ul.plant-autocomplete-list
                = hidden_field_tag "plant_id_#{sighting.id}", sighting.plant_id, class: 'moderation-plant-id'
                .moderation-plant-actions
                  %button.btn.btn-default.btn-sm.moderation-assign-plant{data: {id: sighting.id}, type: 'button', disabled: sighting.plant_id.blank?}
                    = I18n.t('.assign_plant', scope: pending_scope)
                  %span.moderation-assign-feedback{data: {id: sighting.id}}

              %p.moderation-meta
                %span.lbl= I18n.t('.author', scope: pending_scope)
                = link_to sighting.user.full_name, profile_path(sighting.user), target: '_blank'

              - if sighting.timestamp.present?
                %p.moderation-meta
                  %span.lbl= I18n.t('.date', scope: pending_scope)
                  = date_format(sighting.timestamp)

              - if sighting.address_valid?
                %p.moderation-meta
                  %span.lbl= I18n.t('.place', scope: pending_scope)
                  = sighting.address_string
                  = link_to I18n.t('.on_map', scope: pending_scope), "https://www.openstreetmap.org/?mlat=#{sighting.latitude}&mlon=#{sighting.longitude}#map=15/#{sighting.latitude}/#{sighting.longitude}", target: '_blank', rel: 'noopener', class: 'link'

              - if sighting.note.present?
                %p.moderation-note= sighting.note

              - if sighting.unknown?
                %p.moderation-plant-warning{data: {warning_for: sighting.id}}
                  = I18n.t('.plant_required_warning', scope: pending_scope)

              .moderation-actions
                %button.btn.btn-success.moderation-approve{data: {id: sighting.id}, type: 'button', disabled: sighting.unknown?}
                  = I18n.t('.approve', scope: pending_scope)
                %button.btn.btn-danger.moderation-reject{data: {id: sighting.id}, type: 'button'}
                  = I18n.t('.reject', scope: pending_scope)

      .row.mtop40.acenter#moderation-empty{style: 'display:none;'}
        %p= I18n.t('.empty', scope: pending_scope)
