%style
  :plain
    .moderation-list {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
    }
    .moderation-card {
      background: #fff;
      border: 1px solid #dfe9d0;
      border-radius: 8px;
      box-shadow: 0 2px 12px rgba(0,0,0,.06);
      width: 100%;
      max-width: 320px;
      overflow: hidden;
    }
    .moderation-card-photo img {
      width: 100%;
      display: block;
    }
    .moderation-card-body {
      padding: 14px 16px;
    }
    .moderation-meta {
      margin-bottom: 6px;
      font-size: 14px;
    }
    .moderation-meta .lbl {
      font-weight: 600;
      margin-right: 4px;
    }
    .moderation-note {
      font-style: italic;
      color: #555;
      margin-bottom: 10px;
    }
    .moderation-actions {
      display: flex;
      gap: 10px;
      margin-top: 12px;
    }
    .moderation-actions .btn {
      flex: 1;
    }
    .moderation-actions .btn[disabled] {
      opacity: .5;
      cursor: not-allowed;
    }
    .moderation-plant-assign {
      margin-bottom: 10px;
    }
    .moderation-plant-label {
      display: block;
      font-weight: 600;
      font-size: 13px;
      margin-bottom: 4px;
    }
    .moderation-plant-autocomplete {
      display: block;
      width: 100%;
    }
    .moderation-plant-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 6px;
    }
    .moderation-assign-plant[disabled] {
      opacity: .5;
      cursor: not-allowed;
    }
    .moderation-assign-feedback {
      font-size: 12px;
      color: #5a8f3c;
    }
    .moderation-plant-warning {
      color: #a94442;
      font-size: 13px;
      margin: 6px 0 0;
    }
    /* "AI bilan aniqlash" (PlantNet, 2b-bosqich) — natija bloki
       plants/index.html.haml'даgi bilan bir xil markup/class'larni
       (_identify_results.html.haml, ikkala kontekstда ham ishlatiladi)
       shu kartaga mos kichraytirilgan uslubda qayta bo'yaydi. */
    .moderation-identify-row {
      margin-bottom: 10px;
    }
    .moderation-identify-not-ready {
      font-size: 12px;
      margin: 0 0 6px;
    }
    .moderation-identify-status {
      font-size: 12px;
      color: #5a8f3c;
      margin-top: 4px;
    }
    .moderation-identify-results {
      margin-top: 6px;
    }
    .moderation-identify-results .sighting-identify-error,
    .moderation-identify-results .sighting-identify-empty {
      font-size: 12px;
      color: #a94442;
    }
    .moderation-identify-results .sighting-identify-disclaimer {
      font-size: 11px;
      color: #777;
      font-style: italic;
      margin-bottom: 6px;
    }
    .moderation-identify-results .sighting-identify-prediction {
      background: #f7faf3;
      border-radius: 4px;
      padding: 6px 8px;
      margin-bottom: 6px;
      font-size: 12px;
    }
    .moderation-identify-results .sighting-identify-prediction-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 6px;
    }
    .moderation-identify-results .sighting-identify-prediction-score {
      color: #5a8f3c;
      font-weight: 700;
      white-space: nowrap;
    }
    .moderation-identify-results .sighting-identify-prediction-common {
      font-size: 11px;
      color: #666;
      margin: 2px 0 4px;
    }
    .moderation-identify-results .sighting-identify-score-bar {
      background: #e5e5e5;
      border-radius: 3px;
      height: 4px;
      overflow: hidden;
      margin: 4px 0;
    }
    .moderation-identify-results .sighting-identify-score-bar-fill {
      background: #5a8f3c;
      height: 100%;
    }
    .moderation-identify-results .sighting-identify-prediction-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 4px;
    }
    .moderation-identify-results .sighting-identify-select-btn {
      font-size: 11px;
      padding: 2px 8px;
      border: 1px solid #5a8f3c;
      color: #5a8f3c;
      background: #fff;
      border-radius: 10px;
      cursor: pointer;
    }
    .moderation-identify-results .sighting-identify-select-btn:hover,
    .moderation-identify-results .sighting-identify-select-btn:focus {
      background: #5a8f3c;
      color: #fff;
    }
    .moderation-identify-results .sighting-identify-profile-link {
      font-size: 11px;
    }
    @media (max-width: 480px) {
      .moderation-card {
        max-width: 100%;
      }
    }

.bg-btm-container
  .container.content
    - pending_scope = 'plant_sightings.pending'
    .row.mtop40
      %h3.acenter= I18n.t('.title', scope: pending_scope)

    - if @plant_sightings.empty?
      .row.mtop40.acenter#moderation-empty
        %p= I18n.t('.empty', scope: pending_scope)
    - else
      .row.moderation-list.mtop30{data: {plant_required_warning: I18n.t('.plant_required_warning', scope: pending_scope)}}
        - @plant_sightings.each do |sighting|
          .moderation-card{id: "sighting-#{sighting.id}"}
            .moderation-card-photo
              = link_to plant_sighting_path(sighting), target: '_blank' do
                = plant_sighting_photo_tag(sighting, :small)

            .moderation-card-body
              .moderation-plant-assign
                %label.moderation-plant-label{for: "plant_query_#{sighting.id}"}= I18n.t('.plant_label', scope: pending_scope)
                .plant-autocomplete.moderation-plant-autocomplete{data: {url: plant_sightings_autocomplete_path, not_found: I18n.t('.not_found', scope: pending_scope)}}
                  = text_field_tag "plant_query_#{sighting.id}", (sighting.plant.present? ? "#{sighting.plant.display_name(I18n.locale)} | #{sighting.plant.display_sci_name}" : nil), class: 'form-control plant-autocomplete-input', autocomplete: 'off', placeholder: I18n.t('.plant_name_placeholder', scope: pending_scope)
                  %ul.plant-autocomplete-list
                = hidden_field_tag "plant_id_#{sighting.id}", sighting.plant_id, class: 'moderation-plant-id'
                .moderation-plant-actions
                  %button.btn.btn-default.btn-sm.moderation-assign-plant{data: {id: sighting.id}, type: 'button', disabled: sighting.plant_id.blank?}
                    = I18n.t('.assign_plant', scope: pending_scope)
                  %span.moderation-assign-feedback{data: {id: sighting.id}}

              .moderation-identify-row
                - if sighting.photo_status_ready?
                  %button.btn.btn-default.btn-sm.moderation-identify-btn{data: {id: sighting.id}, type: 'button'}
                    🔍
                    = I18n.t('button', scope: 'plant_sightings.edit.identify')
                - elsif sighting.photo_status_failed?
                  %p.text-muted.moderation-identify-not-ready= I18n.t('plant_sightings.photo_failed')
                - else
                  %p.text-muted.moderation-identify-not-ready= I18n.t('not_ready', scope: 'plant_sightings.edit.identify.errors')
                .moderation-identify-status{data: {id: sighting.id}, style: 'display:none;'}= I18n.t('loading', scope: 'plant_sightings.edit.identify')
                .moderation-identify-results{data: {id: sighting.id, error_generic: I18n.t('generic', scope: 'plants.index.identify.errors')}}

              %p.moderation-meta
                %span.lbl= I18n.t('.author', scope: pending_scope)
                = link_to sighting.user.full_name, profile_path(sighting.user), target: '_blank'

              - if sighting.timestamp.present?
                %p.moderation-meta
                  %span.lbl= I18n.t('.date', scope: pending_scope)
                  = date_format(sighting.timestamp)

              - if sighting.address_valid?
                %p.moderation-meta
                  %span.lbl= I18n.t('.place', scope: pending_scope)
                  = sighting.address_string
                  = link_to I18n.t('.on_map', scope: pending_scope), "https://www.openstreetmap.org/?mlat=#{sighting.latitude}&mlon=#{sighting.longitude}#map=15/#{sighting.latitude}/#{sighting.longitude}", target: '_blank', rel: 'noopener', class: 'link'

              - if sighting.note.present?
                %p.moderation-note= sighting.note

              - if sighting.unknown?
                %p.moderation-plant-warning{data: {warning_for: sighting.id}}
                  = I18n.t('.plant_required_warning', scope: pending_scope)

              .moderation-actions
                %button.btn.btn-success.moderation-approve{data: {id: sighting.id}, type: 'button', disabled: sighting.unknown?}
                  = I18n.t('.approve', scope: pending_scope)
                %button.btn.btn-danger.moderation-reject{data: {id: sighting.id}, type: 'button'}
                  = I18n.t('.reject', scope: pending_scope)

      .row.mtop40.acenter#moderation-empty{style: 'display:none;'}
        %p= I18n.t('.empty', scope: pending_scope)
