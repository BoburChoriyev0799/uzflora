%style
  :plain
    /* CSS Grid — oldingi flex-wrap'da qatorlar orasida ustunlar
       tekislanmasdi (har flex qatori o'z ichida mustaqil joylashadi,
       yuqoridagi qatorning ustun chegaralariga bog'liq emas). Grid'da
       esa ustun soni ANIQ belgilangani uchun har qator bir xil
       chegaralarga tekislanadi, kartochka balandligi har xil bo'lsa ham
       (`align-items: stretch` — standart qiymat — har qatorni o'zaro
       teng balandlikka cho'zadi). */
    .moderation-list {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 20px;
      /* overflow-x kerak emasligini kafolatlaydi — grid ustunlari
         minmax(0, 1fr) bo'lgani uchun konteynerdan tashqariga
         "toshib" ketolmaydi, ichidagi kontent esa quyidagi
         min-width:0 orqali cheklanadi. */
      overflow-x: hidden;
    }
    /* MUHIM: `.moderation-list` `.row` klassini ham olib yuradi
       (Bootstrap 3'ning clearfix'i uchun), Bootstrap esa HAR bir
       `.row` uchun `:before`/`:after` psevdo-elementlarini
       `content: " "; display: table;` bilan beradi. CSS Grid
       spetsifikatsiyasiga ko'ra, `content` qiymati bor va
       `display: none` bo'lmagan psevdo-elementlar GRID A'ZOSI
       sifatida HISOBLANADI — ya'ni bu ikkala "bo'sh" psevdo-element
       birinchi va oxirgi katakni egallab, haqiqiy kartochkalarni
       2-ustundan boshlab surib yuborardi (production'da ko'rilgan
       "birinchi katak bo'sh" nuqsonining ANIQ sababi shu — konteyner
       ICHIDA ortiqcha HAML elementi YO'Q edi, muammo psevdo-element
       edi). Shu ikkalasini butunlay o'chiramiz. */
    .moderation-list:before,
    .moderation-list:after {
      content: none;
      display: none;
    }
    @media (max-width: 1199px) {
      .moderation-list {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }
    @media (max-width: 899px) {
      .moderation-list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    @media (max-width: 599px) {
      .moderation-list {
        grid-template-columns: minmax(0, 1fr);
      }
    }
    .moderation-card {
      background: #fff;
      border: 1px solid #dfe9d0;
      border-radius: 8px;
      box-shadow: 0 2px 12px rgba(0,0,0,.06);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      /* Grid/flex a'zolarining standart min-width'i "auto" (kontent
         o'lchamiga qarab) — uzun so'z/manzil/nom katakni kengaytirib,
         butun sahifada gorizontal scroll paydo qilishi mumkin edi
         (telefonda "Rad etish" tugmasi kesilib qolgan nuqson — shu
         sababdan). 0 qilib qo'yish katakni konteyner kengligiga
         cheklaydi, ichidagi matn esa o'ralib (wrap) ko'rinadi. */
      min-width: 0;
    }
    /* Rasm maydoni bir xil nisbatda (4:3) kesiladi — turli o'lchamdagi
       rasmlar kartochka balandligini buzmasin. Rasm hali tayyor
       bo'lmagan/xato holatida (plant_sighting_photo_tag matn/status
       qaytaradi, img emas) ham konteyner o'lchami o'zgarmasligi uchun
       nisbat KARTOCHKA (rasm emas) darajasida belgilanadi. */
    .moderation-card-photo {
      aspect-ratio: 4 / 3;
      overflow: hidden;
      background: #eee;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .moderation-card-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .moderation-card-body {
      padding: 14px 16px;
      display: flex;
      flex-direction: column;
      flex: 1 1 auto;
      min-width: 0;
    }
    .moderation-meta {
      margin-bottom: 6px;
      font-size: 14px;
      overflow-wrap: break-word;
    }
    .moderation-meta .lbl {
      font-weight: 600;
      margin-right: 4px;
    }
    .moderation-note {
      font-style: italic;
      color: #555;
      margin-bottom: 10px;
    }
    /* `margin-top: auto` — .moderation-card-body flex-column bo'lgani
       uchun bu qatorni HAR DOIM kartochka TAGIGA yopishtiradi, undan
       yuqoridagi matn (izoh, manzil va h.k.) uzunligidan qat'i nazar —
       tugmalar barcha kartochkalarda bir xil balandlikda turadi. */
    .moderation-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: auto;
      padding-top: 12px;
    }
    /* `flex: 1 1 auto` (0 emas) — tugmalar "Tasdiqlash"/"Rad etish"
       matni sig'masa (tor kartochka), 0 asosli flex ularni matn
       kesilguncha toraytirar edi (telefonda "Rad etish" kesilib
       qolgan nuqson shu). `min-width` bilan bittasi bo'lmasa,
       ikkalasi ENG KAMIDA 100px'gacha, kerak bo'lsa `flex-wrap`
       tufayli navbatdagi qatorga tushadi. */
    .moderation-actions .btn {
      flex: 1 1 auto;
      min-width: 100px;
    }
    .moderation-actions .btn[disabled] {
      opacity: .5;
      cursor: not-allowed;
    }
    .moderation-plant-assign {
      margin-bottom: 10px;
    }
    .moderation-plant-label {
      display: block;
      font-weight: 600;
      font-size: 13px;
      margin-bottom: 4px;
    }
    .moderation-plant-autocomplete {
      display: block;
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
    }
    .moderation-plant-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      margin-top: 6px;
    }
    .moderation-assign-plant[disabled] {
      opacity: .5;
      cursor: not-allowed;
    }
    .moderation-assign-feedback {
      font-size: 12px;
      color: #5a8f3c;
    }
    .moderation-plant-warning {
      color: #a94442;
      font-size: 13px;
      margin: 6px 0 0;
    }
    /* "AI bilan aniqlash" (PlantNet, 2b-bosqich) — natija bloki
       plants/index.html.haml'даgi bilan bir xil markup/class'larni
       (_identify_results.html.haml, ikkala kontekstда ham ishlatiladi)
       shu kartaga mos kichraytirilgan uslubda qayta bo'yaydi. */
    .moderation-identify-row {
      margin-bottom: 10px;
    }
    .moderation-identify-not-ready {
      font-size: 12px;
      margin: 0 0 6px;
    }
    .moderation-identify-status {
      font-size: 12px;
      color: #5a8f3c;
      margin-top: 4px;
    }
    .moderation-identify-results {
      margin-top: 6px;
    }
    .moderation-identify-results .sighting-identify-error,
    .moderation-identify-results .sighting-identify-empty {
      font-size: 12px;
      color: #a94442;
    }
    .moderation-identify-results .sighting-identify-disclaimer {
      font-size: 11px;
      color: #777;
      font-style: italic;
      margin-bottom: 6px;
    }
    .moderation-identify-results .sighting-identify-prediction {
      background: #f7faf3;
      border-radius: 4px;
      padding: 6px 8px;
      margin-bottom: 6px;
      font-size: 12px;
    }
    .moderation-identify-results .sighting-identify-prediction-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 6px;
    }
    .moderation-identify-results .sighting-identify-prediction-score {
      color: #5a8f3c;
      font-weight: 700;
      white-space: nowrap;
    }
    .moderation-identify-results .sighting-identify-prediction-common {
      font-size: 11px;
      color: #666;
      margin: 2px 0 4px;
    }
    .moderation-identify-results .sighting-identify-score-bar {
      background: #e5e5e5;
      border-radius: 3px;
      height: 4px;
      overflow: hidden;
      margin: 4px 0;
    }
    .moderation-identify-results .sighting-identify-score-bar-fill {
      background: #5a8f3c;
      height: 100%;
    }
    .moderation-identify-results .sighting-identify-prediction-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 4px;
    }
    .moderation-identify-results .sighting-identify-select-btn {
      font-size: 11px;
      padding: 2px 8px;
      border: 1px solid #5a8f3c;
      color: #5a8f3c;
      background: #fff;
      border-radius: 10px;
      cursor: pointer;
    }
    .moderation-identify-results .sighting-identify-select-btn:hover,
    .moderation-identify-results .sighting-identify-select-btn:focus {
      background: #5a8f3c;
      color: #fff;
    }
    .moderation-identify-results .sighting-identify-profile-link {
      font-size: 11px;
    }
    /* Jamoaviy aniqlash vidjeti — moderatsiya kartochkasi ichida ixcham
       ko'rinishda (asosiy uslub plant_sightings/show.html.haml'da,
       .identifications-widget/.identification-*). Bu yerda faqat
       o'lcham/bo'shliqlar torайtiriladi, ranglar o'zgarmaydi. */
    .moderation-card .identifications-widget {
      margin-top: 10px;
      padding: 10px 12px;
      font-size: 12px;
    }
    .moderation-card .identification-progress-text,
    .moderation-card .identification-plant,
    .moderation-card .identification-guest-note {
      font-size: 11px;
    }
    .moderation-card .identification-avatar {
      width: 26px;
      height: 26px;
    }
    .moderation-card .identification-propose-label {
      font-size: 12px;
    }
.bg-btm-container
  .container.content
    - pending_scope = 'plant_sightings.pending'
    .row.mtop40
      %h3.acenter= I18n.t('.title', scope: pending_scope)

    - if @plant_sightings.empty?
      .row.mtop40.acenter#moderation-empty
        %p= I18n.t('.empty', scope: pending_scope)
    - else
      .row.moderation-list.mtop30{data: {plant_required_warning: I18n.t('.plant_required_warning', scope: pending_scope)}}
        - @plant_sightings.each do |sighting|
          .moderation-card{id: "sighting-#{sighting.id}"}
            .moderation-card-photo
              = link_to plant_sighting_path(sighting), target: '_blank' do
                = plant_sighting_photo_tag(sighting, :small)

            .moderation-card-body
              .moderation-plant-assign
                %label.moderation-plant-label{for: "plant_query_#{sighting.id}"}= I18n.t('.plant_label', scope: pending_scope)
                .plant-autocomplete.moderation-plant-autocomplete{data: {url: plant_sightings_autocomplete_path, not_found: I18n.t('.not_found', scope: pending_scope)}}
                  = text_field_tag "plant_query_#{sighting.id}", (sighting.plant.present? ? "#{sighting.plant.display_name(I18n.locale)} | #{sighting.plant.display_sci_name}" : nil), class: 'form-control plant-autocomplete-input', autocomplete: 'off', placeholder: I18n.t('.plant_name_placeholder', scope: pending_scope)
                  %ul.plant-autocomplete-list
                = hidden_field_tag "plant_id_#{sighting.id}", sighting.plant_id, class: 'moderation-plant-id'
                .moderation-plant-actions
                  %button.btn.btn-default.btn-sm.moderation-assign-plant{data: {id: sighting.id}, type: 'button', disabled: sighting.plant_id.blank?}
                    = I18n.t('.assign_plant', scope: pending_scope)
                  %span.moderation-assign-feedback{data: {id: sighting.id}}

              .moderation-identify-row
                - if sighting.photo_status_ready?
                  %button.btn.btn-default.btn-sm.moderation-identify-btn{data: {id: sighting.id}, type: 'button'}
                    🔍
                    = I18n.t('button', scope: 'plant_sightings.edit.identify')
                - elsif sighting.photo_status_failed?
                  %p.text-muted.moderation-identify-not-ready= I18n.t('plant_sightings.photo_failed')
                - else
                  %p.text-muted.moderation-identify-not-ready= I18n.t('not_ready', scope: 'plant_sightings.edit.identify.errors')
                .moderation-identify-status{data: {id: sighting.id}, style: 'display:none;'}= I18n.t('loading', scope: 'plant_sightings.edit.identify')
                .moderation-identify-results{data: {id: sighting.id, error_generic: I18n.t('generic', scope: 'plants.index.identify.errors')}}

              = render 'identifications', plant_sighting: sighting, compact: true

              %p.moderation-meta
                %span.lbl= I18n.t('.author', scope: pending_scope)
                = link_to sighting.user.full_name, profile_path(sighting.user), target: '_blank'

              - if sighting.identified_by.present?
                %p.moderation-meta
                  %span.lbl= I18n.t('.identified_by', scope: pending_scope)
                  = link_to sighting.identified_by.full_name, profile_path(sighting.identified_by), target: '_blank'

              - if sighting.timestamp.present?
                %p.moderation-meta
                  %span.lbl= I18n.t('.date', scope: pending_scope)
                  = date_format(sighting.timestamp)

              - if sighting.address_valid?
                %p.moderation-meta
                  %span.lbl= I18n.t('.place', scope: pending_scope)
                  = sighting.address_string
                  = link_to I18n.t('.on_map', scope: pending_scope), "https://www.openstreetmap.org/?mlat=#{sighting.latitude}&mlon=#{sighting.longitude}#map=15/#{sighting.latitude}/#{sighting.longitude}", target: '_blank', rel: 'noopener', class: 'link'

              - if sighting.note.present?
                %p.moderation-note= sighting.note

              - if sighting.unknown?
                %p.moderation-plant-warning{data: {warning_for: sighting.id}}
                  = I18n.t('.plant_required_warning', scope: pending_scope)

              .moderation-actions
                %button.btn.btn-success.moderation-approve{data: {id: sighting.id}, type: 'button', disabled: sighting.unknown?}
                  = I18n.t('.approve', scope: pending_scope)
                %button.btn.btn-danger.moderation-reject{data: {id: sighting.id}, type: 'button'}
                  = I18n.t('.reject', scope: pending_scope)

      .row.mtop40.acenter#moderation-empty{style: 'display:none;'}
        %p= I18n.t('.empty', scope: pending_scope)
