.row
  = plant_sighting_photo_tag(sighting, :small, class: 'img-responsive sm-centered mbtm15')

  - if sighting.timestamp.present?
    .row.add-photo-info
      .col.col-md-4.aright
        %p
          %span.lbl= I18n.t('.date', scope: 'plant_sightings.show')
      .col.col-md-8.aleft
        %p= date_format(sighting.timestamp)

  - if sighting.address_valid?
    .row.add-photo-info
      .col.col-md-4.aright
        %p
          %span.lbl= I18n.t('.place', scope: 'plant_sightings.show')
      .col.col-md-8.aleft
        %p= plant_sighting_location(sighting)
