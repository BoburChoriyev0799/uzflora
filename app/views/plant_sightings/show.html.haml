%style
  :plain
    /* Kuzatuv rasmi: `:display` versiyasi (resize_to_fill) rasmni QIRQIB
       700x524'ga moslardi — bo'yiga yoki eniga cho'zilgan rasmlarda
       tepa/pastki yoki yon qismlar kesilib qolardi. Shu o'rniga `:original`
       (faqat resize_to_limit, 1600px'gacha, HECH QISH QIRQILMAYDI)
       ishlatiladi, nisbat CSS orqali saqlanadi (max-width/max-height +
       height:auto — object-fit: contain qo'shimcha ehtiyot chorasi). */
    .plant-sighting-photo-frame {
      display: flex;
      justify-content: center;
      margin-bottom: 16px;
    }
    .plant-sighting-photo-img {
      max-width: 800px;
      max-height: 65vh;
      width: auto;
      height: auto;
      object-fit: contain;
      border-radius: 6px;
      box-shadow: 0 2px 10px rgba(0,0,0,.08);
    }
    @media (max-width: 480px) {
      .plant-sighting-photo-img {
        max-height: 45vh;
      }
    }
    /* IZOHLAR — 💬 belgisi (bosilganda pastdagi blok ochiladi/yopiladi) */
    .sighting-comment-toggle {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: #4a6b3a;
      font-weight: 600;
      margin-bottom: 14px;
      text-decoration: none !important;
    }
    .sighting-comment-toggle:hover,
    .sighting-comment-toggle:focus {
      color: #046A38;
    }
    .sighting-comment-icon {
      font-size: 18px;
      line-height: 1;
    }
    .sighting-comment-count {
      font-size: 14px;
    }
    .sighting-comments-block {
      margin-bottom: 16px;
    }
    .comment-char-count {
      display: inline-block;
      font-size: 12px;
      color: #888;
      margin: 4px 10px 0 0;
    }
    /* JAMOAVIY ANIQLASH — belgi Qizil kitob nishoni (.plant-red-book-badge,
       plants/index.html.haml) bilan bir xil uslub, lekin ko'k rangda
       (ikkalasi bir sahifada uchrasa aralashib ketmasin). */
    .research-grade-badge {
      display: inline-block;
      background: #0b5394;
      color: #fff;
      font-size: 12px;
      padding: 3px 9px;
      border-radius: 10px;
      margin-bottom: 10px;
    }
    .identifications-widget {
      margin-top: 10px;
      padding: 14px 16px;
      background: #f7faf3;
      border: 1px solid #e2ecd9;
      border-radius: 8px;
    }
    .identification-progress {
      margin-bottom: 12px;
    }
    .identification-progress-bar {
      display: flex;
      gap: 4px;
    }
    .identification-progress-segment {
      flex: 1 1 auto;
      height: 8px;
      border-radius: 4px;
      background: #dfe9d0;
    }
    .identification-progress-segment.filled {
      background: #4a9c4a;
    }
    .identification-progress-text {
      margin: 6px 0 0;
      font-size: 13px;
      color: #555;
    }
    .identification-progress-expert {
      display: inline-block;
      font-weight: 600;
      color: #1e5620;
      font-size: 13px;
    }
    .identification-list {
      margin-bottom: 14px;
    }
    .identification-empty {
      color: #888;
      font-style: italic;
      font-size: 13px;
    }
    .identification-row {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 0;
      border-bottom: 1px solid #e9efe0;
    }
    .identification-row:last-child {
      border-bottom: none;
    }
    .identification-avatar {
      width: 34px;
      height: 34px;
      object-fit: cover;
      flex-shrink: 0;
    }
    .identification-body {
      flex: 1 1 auto;
      min-width: 0;
    }
    .identification-name {
      margin: 0;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .identification-plant {
      margin: 0;
      font-style: italic;
      color: #555;
      font-size: 13px;
    }
    .identification-withdraw-lnk,
    .identification-delete-lnk {
      flex-shrink: 0;
      font-size: 12px;
      color: #a94442;
    }
    .identification-propose-form {
      border-top: 1px solid #e2ecd9;
      padding-top: 12px;
    }
    .identification-propose-label {
      display: block;
      font-weight: 600;
      font-size: 13px;
      margin-bottom: 6px;
    }
    .identification-propose {
      display: block;
      max-width: 100%;
    }
    .identification-propose-btn {
      margin-top: 8px;
    }
    .identification-propose-btn[disabled] {
      opacity: .5;
      cursor: not-allowed;
    }
    .identification-guest-note {
      font-size: 13px;
      color: #555;
      border-top: 1px solid #e2ecd9;
      padding-top: 12px;
      margin: 0;
    }
.bg-btm-container
  .container.content
    - show_scope = 'plant_sightings.show'
    .row.mtop20.mbtm20
      .col-md-8.col-sm-12.col-xs-12
        - if @plant_sighting[:photo].present? && @plant_sighting.photo_status_ready?
          .plant-sighting-photo-frame
            = link_to @plant_sighting.photo.url, target: '_blank', rel: 'noopener', title: I18n.t('.view_full', scope: show_scope) do
              = plant_sighting_photo_tag(@plant_sighting, :original, class: 'img-responsive plant-sighting-photo-img')
        - elsif @plant_sighting[:photo].present?
          .plant-sighting-photo-frame
            = plant_sighting_photo_tag(@plant_sighting, :original, class: 'img-responsive plant-sighting-photo-img')

        = render 'plant_sightings/comment_toggle', plant_sighting: @plant_sighting

        %h3.mtop20
          - if @plant_sighting.plant.present?
            = link_to @plant_sighting.plant.display_name(I18n.locale), plant_path(@plant_sighting.plant)
          - else
            = I18n.t('.unknown_plant', scope: show_scope)
          - if @plant_sighting.owner?(current_user)
            = plant_sighting_status_badge(@plant_sighting)

        - if @plant_sighting.owner?(current_user) && @plant_sighting.rejected? && @plant_sighting.moderation_note.present?
          %p.mtop10
            %span.lbl= I18n.t('.rejection_reason', scope: show_scope)
            = @plant_sighting.moderation_note

        = render 'plant_names', plant: @plant_sighting.plant

        - if @plant_sighting.note.present?
          %p.mtop10
            %span.lbl= I18n.t('.note', scope: show_scope)
            = @plant_sighting.note

        %p.mtop10
          %span.lbl= I18n.t('.author', scope: show_scope)
          = link_to @plant_sighting.user.full_name, profile_path(@plant_sighting.user)

        - if @plant_sighting.identified_by.present? && @plant_sighting.identified_by_id != @plant_sighting.user_id
          %p.mtop10
            %span.lbl= I18n.t('.identified_by', scope: show_scope)
            = link_to @plant_sighting.identified_by.full_name, profile_path(@plant_sighting.identified_by)

        - if @plant_sighting.timestamp.present?
          %p
            %span.lbl= I18n.t('.date', scope: show_scope)
            = date_format(@plant_sighting.timestamp)

        - if @plant_sighting.address_valid?
          %p
            %span.lbl= I18n.t('.place', scope: show_scope)
            %a.link.sighting-map-toggle{href: '#', data: {lat: @plant_sighting.latitude, lng: @plant_sighting.longitude}}
              = @plant_sighting.address_string
          #sighting_map_canvas{style: 'display:none; width:100%; height:300px; margin-top:10px;'}

        = render 'identifications', plant_sighting: @plant_sighting
