-# Section 9: 2FA kod kiritish — kirish sahifasi bilan bir xil uslub.
- content_for :body_class, 'auth-body'
- scope = 'two_factor.otp_session'
.auth-page
  .auth-card.auth-card--single
    .auth-form-box
      %h2.auth-form-title= I18n.t('.title', scope: scope)
      %p.auth-hint= I18n.t('.intro', scope: scope)
      = render 'shared/auth_errors', show: true
      = form_tag user_otp_path, method: :post do
        .auth-field
          %label.auth-visually-hidden{ for: 'auth-otp-code' }= I18n.t('.code_placeholder', scope: scope)
          = text_field_tag :code, nil, id: 'auth-otp-code', autofocus: true, autocomplete: 'one-time-code', inputmode: 'numeric', class: 'auth-input', placeholder: I18n.t('.code_placeholder', scope: scope)
          %span.auth-field-icon= auth_icon(:lock)
        = submit_tag I18n.t('.submit', scope: scope), class: 'auth-submit'
      = link_to I18n.t('.back_to_login', scope: scope), new_user_session_path, class: 'auth-forgot'
