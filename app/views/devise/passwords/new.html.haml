-# Section 9: parol tiklash — kirish sahifasi bilan bir xil fon va karta
-# uslubida (foydalanuvchi o'tganda dizayn keskin o'zgarmasin).
- content_for :body_class, 'auth-body'
- devise_scope = 'devise.passwords.new'
.auth-page
  .auth-card.auth-card--single
    .auth-form-box
      %h2.auth-form-title= I18n.t('.title', scope: devise_scope)
      %p.auth-hint= I18n.t('.subtitle', scope: devise_scope)
      = render 'shared/auth_errors', show: true
      = form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f|
        .auth-field
          %label.auth-visually-hidden{ for: 'auth-pw-email' }= I18n.t('.email', scope: devise_scope)
          = f.email_field :email, id: 'auth-pw-email', class: 'auth-input', placeholder: I18n.t('.email', scope: devise_scope), autofocus: true, autocomplete: 'username', required: true
          %span.auth-field-icon= auth_icon(:mail)
        = f.submit I18n.t('.submit', scope: devise_scope), class: 'auth-submit'
      = link_to I18n.t('.back_to_login', scope: devise_scope), new_user_session_path, class: 'auth-forgot'
