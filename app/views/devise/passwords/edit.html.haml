-# Section 9: yangi parol o'rnatish — kirish sahifasi bilan bir xil uslub.
- content_for :body_class, 'auth-body'
- devise_scope = 'devise.passwords.edit'
.auth-page
  .auth-card.auth-card--single
    .auth-form-box
      %h2.auth-form-title= I18n.t('.title', scope: devise_scope)
      = render 'shared/auth_errors', show: true
      = form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f|
        = f.hidden_field :reset_password_token
        .auth-field
          %label.auth-visually-hidden{ for: 'auth-pw-new' }= I18n.t('.new_password', scope: devise_scope)
          = f.password_field :password, id: 'auth-pw-new', class: 'auth-input', placeholder: I18n.t('.new_password', scope: devise_scope), autofocus: true, autocomplete: 'new-password', required: true
          %span.auth-field-icon= auth_icon(:lock)
        .auth-field
          %label.auth-visually-hidden{ for: 'auth-pw-confirm' }= I18n.t('.confirm_password', scope: devise_scope)
          = f.password_field :password_confirmation, id: 'auth-pw-confirm', class: 'auth-input', placeholder: I18n.t('.confirm_password', scope: devise_scope), autocomplete: 'new-password', required: true
          %span.auth-field-icon= auth_icon(:lock)
        = f.submit I18n.t('.submit', scope: devise_scope), class: 'auth-submit', data: { disable_with: I18n.t('.submitting', scope: devise_scope) }
