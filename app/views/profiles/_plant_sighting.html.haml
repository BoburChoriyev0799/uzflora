- can_manage = @user.current?(current_user) || current_user.try(:expert?)
.col-sm-6.col-md-2.map-img-block.img-container-blck.profile-bird-container.profile-sighting-card
  =link_to plant_sighting_path(plant_sighting), class: 'profile-sighting-photo' do
    = plant_sighting_photo_tag(plant_sighting, :small)
  .profile-sighting-body
    .plant-sighting-header
      .plant-name
        = plant_sighting.plant.present? ? plant_sighting.plant.display_sci_name : I18n.t('profile.photo.unknown_plant')
      .profile-sighting-badges
        - if can_manage
          = plant_sighting_status_badge(plant_sighting)
        - if plant_sighting.research_grade?
          .research-grade-badge= I18n.t('research_grade_badge', scope: 'identifications')
    .profile-sighting-meta
      - if plant_sighting.timestamp.present?
        %p.profile-sighting-date= date_format(plant_sighting.timestamp)
      - if plant_sighting.address_valid?
        %p.profile-sighting-place= plant_sighting.address_string
    .profile-sighting-actions{class: ('single-action' unless can_manage)}
      = render 'plant_sightings/comment_modal_trigger', plant_sighting: plant_sighting
      - if can_manage
        %a.sighting-action-btn.edit_user_bird{href: edit_plant_plant_sighting_path(plant_sighting), data: {id: plant_sighting.id}, title: I18n.t('profile.photo.edit')}
          %svg.sighting-action-icon{xmlns: 'http://www.w3.org/2000/svg', viewBox: '0 0 24 24', fill: 'none', stroke: 'currentColor', 'stroke-width' => '2', 'stroke-linecap' => 'round', 'stroke-linejoin' => 'round'}
            %path{d: 'M12 20h9'}
            %path{d: 'M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z'}
        %a.sighting-action-btn.sighting-delete-btn.delete_user_plant_sighting{href: '#', data: {id: plant_sighting.id}, title: I18n.t('profile.photo.delete')}
          %svg.sighting-action-icon{xmlns: 'http://www.w3.org/2000/svg', viewBox: '0 0 24 24', fill: 'none', stroke: 'currentColor', 'stroke-width' => '2', 'stroke-linecap' => 'round', 'stroke-linejoin' => 'round'}
            %polyline{points: '3 6 5 6 21 6'}
            %path{d: 'M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2'}
            %line{x1: '10', y1: '11', x2: '10', y2: '17'}
            %line{x1: '14', y1: '11', x2: '14', y2: '17'}
