%style
  :plain
    /* Suratlar/qoralamalar kartochkasi (profiles/_plant_sighting.html.haml)
       — eski uslub "×" o'chirish/✏️ tahrirlash belgilarini rasm ustiga
       position:absolute bilan qo'yardi (profile.css.scss'даgi
       `.profile-birds-block a.delete_user_plant_sighting`/`a.edit_user_bird`
       qoidalari), bu "Ilmiy tadqiqotlar uchun" belgisi bilan ustma-ust
       tushardi — o'sha qoidalar olib tashlandi. Endi barcha amal
       tugmalari kartochka PASTIDA, oddiy flex qatorda (SVG belgilar
       bilan), belgilar esa matn qismida, rasm ustida hech narsa yo'q.
       Bu blok kartochkalar SONIga qarab TAKRORLANMASIN deb (collection
       render) sahifaning o'zida, partial'da emas. */
    .profile-sighting-body {
      display: flex;
      flex-direction: column;
      flex: 1 1 auto;
      padding: 8px 10px 10px;
    }
    .profile-sighting-badges {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 4px;
      margin-top: 4px;
    }
    .profile-sighting-card .sighting-status-badge {
      margin: 0;
    }
    .profile-sighting-card .research-grade-badge {
      align-self: auto;
      margin: 0;
      font-size: 9px;
      padding: 2px 6px;
    }
    .profile-sighting-actions {
      display: flex;
      align-items: stretch;
      gap: 4px;
      margin-top: auto;
      padding-top: 8px;
    }
    .profile-sighting-actions.single-action {
      justify-content: center;
    }
    .sighting-action-btn {
      flex: 1 1 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      padding: 6px 4px;
      border: 1px solid #e2e2e2;
      border-radius: 6px;
      background: #f7faf3;
      color: #4a6b3a;
      text-decoration: none !important;
      cursor: pointer;
      font-size: 11px;
      font-weight: 600;
      line-height: 1;
      transition: background-color .15s ease, color .15s ease;
    }
    .sighting-action-btn:hover,
    .sighting-action-btn:focus {
      background: #eaf1e2;
      color: #046A38;
    }
    .sighting-delete-btn:hover,
    .sighting-delete-btn:focus {
      background: #fbe0e0;
      color: #a32626;
    }
    .profile-sighting-actions.single-action .sighting-action-btn {
      flex: 0 1 auto;
      padding-left: 18px;
      padding-right: 18px;
    }
    .sighting-action-icon {
      width: 16px;
      height: 16px;
      flex-shrink: 0;
      pointer-events: none;
    }
    @media (max-width: 767px) {
      .profile-sighting-body {
        padding: 6px 6px 8px;
      }
      .sighting-action-btn {
        font-size: 0;
        padding: 6px 2px;
      }
      .profile-sighting-actions.single-action .sighting-action-btn {
        padding-left: 12px;
        padding-right: 12px;
      }
      .sighting-action-icon {
        width: 15px;
        height: 15px;
      }
      .profile-sighting-card .sighting-comment-count {
        font-size: 10px;
      }
    }

= render 'plant_sightings/comment_modal'

.bg-btm-container
  / Content
  .container.content
    - profile_scope = 'profile.show'
    / Content BODY
    .row.profile-container.mtop20.mbtm40.content-container
      .row.profile-info-block
        .col-md-3.col-sm-5.profile-user-data
          %h4
            =image_tag @user.avatar.thumb.url, class: 'img img-circle'
            =@user.full_name
        -if @user.subscribed?(Time.zone.now.year)
          .col-md-3.col-sm-12.profile-stat-data
            %p
              = I18n.t('.bg_amount_1', scope: profile_scope)
              =link_to "#{I18n.t('.bg_amount_2', scope: profile_scope)} - #{@big_year_species_count}", big_year_path
              %br
                = I18n.t('.rating_1', scope: profile_scope)
                =link_to "#{I18n.t('.rating_2', scope: profile_scope)} - #{@big_year_rating}", big_year_path
        .col-md-3.col-sm-12.profile-user-icons
          -if @user.expert?
            = render 'shared/expert_icon', size: 36
        -unless @user.current?(current_user)
          .col-md-3.col-sm-12.profile-follow-block
            = render 'follow_button', user: @user

      .row.sub-nav-pils.mtop20.sm-display-none
        -if @user.current?(current_user)
          %a.active.profile-menu{"data-view" => "block1"}
            .menu-title
              %span
                = I18n.t('.tab_profile', scope: profile_scope)
        %a.profile-menu{"data-view" => "block2"}
          .menu-title
            %span
              #{I18n.t('.tab_species', scope: profile_scope)} [#{@species.size}]
        %a.profile-menu{"data-view" => "block3"}
          .menu-title
            %span
              = I18n.t('.tab_photo', scope: profile_scope)
            %span.profile-birds-count [#{@sightings.total_count}]
        -if @user.current?(current_user)
          %a.profile-menu{"data-view" => "block4"}
            .menu-title
              %span
                = I18n.t('.tab_drafts', scope: profile_scope)
              %span.profile-drafts-count [#{@drafts.size}]
        %a.profile-menu{"data-view" => "block5"}
          .menu-title
            %span
              = I18n.t('.tab_comments', scope: profile_scope)
            %span.profile-comments-count [#{@comments.total_count}]
        %a.profile-menu{"data-view" => "block6"}
          .menu-title
            %span
              #{I18n.t('.tab_following', scope: profile_scope)} [#{@following.size}]
        %a.profile-menu{"data-view" => "block7"}
          .menu-title
            %span
              = I18n.t('.tab_followers', scope: profile_scope)
            %span.profile-followers-count [<span class="followers-count">#{@followers.size}</span>]

      .row.blocks-content
        -if @user.current?(current_user)
          .block-holder
            .mobile-blocks-nav
              %a.active{"data-view" => "block1"}
                %span
                  = I18n.t('.tab_profile', scope: profile_scope)
            =render 'profile'

        .block-holder
          .mobile-blocks-nav
            %a{"data-view" => "block2"}
              %span
                #{I18n.t('.tab_species', scope: profile_scope)} [#{@species.size}]
          #block2.row.profile-block-container.profile-species-block.mtop20{ :class => ('active-block' unless @user.current?(current_user)) }
            =render 'species', user_id: @user.id

        .block-holder
          .mobile-blocks-nav
            %a{"data-view" => "block3"}
              %span
                = I18n.t('.tab_photo', scope: profile_scope)
              %span.profile-birds-count [#{@sightings.total_count}]
          #block3.row.profile-block-container.profile-birds-block.mtop20
            .row
              .row.row-sm.profile-birds-container
                =render partial: 'plant_sighting', collection: @sightings, as: :plant_sighting
              .birds-pagination.pagination-block
                =paginate @sightings, :remote => true, :param_name => 'page_sightings'

        -if @user.current?(current_user)
          .block-holder
            .mobile-blocks-nav
              %a{"data-view" => "block4"}
                %span
                  = I18n.t('.tab_drafts', scope: profile_scope)
                %span.profile-drafts-count [#{@drafts.size}]
            #block4.row.profile-block-container.profile-drafts-block.mtop20
              .row
                .row.row-sm.profile-birds-container
                  =render partial: 'plant_sighting', collection: @drafts, as: :plant_sighting

        .block-holder
          .mobile-blocks-nav
            %a{"data-view" => "block5"}
              %span
                = I18n.t('.tab_comments', scope: profile_scope)
              %span.profile-comments-count [#{@comments.total_count}]
          #block5.row.profile-block-container.profile-comments-block.mtop20
            .row
              .comments-container
                =render 'comments'
              .comments-pagination.pagination-block
                =paginate @comments, :remote => true, :param_name => 'page_comments'

        .block-holder
          .mobile-blocks-nav
            %a{"data-view" => "block6"}
              %span
                #{I18n.t('.tab_following', scope: profile_scope)} [#{@following.size}]
          #block6.row.profile-block-container.profile-follows-block.mtop20
            = render 'follows_list', users: @following

        .block-holder
          .mobile-blocks-nav
            %a{"data-view" => "block7"}
              %span
                #{I18n.t('.tab_followers', scope: profile_scope)} [<span class="followers-count">#{@followers.size}</span>]
          #block7.row.profile-block-container.profile-follows-block.mtop20
            = render 'follows_list', users: @followers
