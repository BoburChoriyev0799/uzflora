%style
  :plain
    /* ============================================================
       4-ISH: PROFIL "SURATLAR" GRIDI — KARTOCHKA ICHKI USLUBI
       ------------------------------------------------------------
       Grid (ustunlar soni 2/3/4/6) style.css.scss'da. Bu yerda faqat
       kartochka ICHI — collection render'da kartochka soniga qarab
       TAKRORLANMASIN deb sahifaning o'zida, partial'da emas.
       ============================================================ */
    .profile-sighting-card {
      display: flex;
      flex-direction: column;
      height: 100%;
      background: #fff;
      border: 1px solid #e6e6e6;
      border-radius: 10px;
      box-shadow: 0 1px 6px rgba(0,0,0,.07);
      overflow: hidden;
      transition: box-shadow .15s ease;
    }
    .profile-sighting-card:hover {
      box-shadow: 0 3px 14px rgba(0,0,0,.13);
    }
    /* B) Rasm chetga yopishmasin — to'rt tomondan TENG 12px, rasm
       burchaklari 6px. */
    .profile-sighting-photo-frame {
      padding: 12px;
    }
    .profile-sighting-photo-frame .sighting-photo-wrap {
      border-radius: 6px;
      overflow: hidden;
    }
    .profile-sighting-photo {
      display: block;
      width: 100%;
      aspect-ratio: 4 / 3;
      background: #f2f2f2;
    }
    .profile-sighting-photo img,
    .profile-sighting-photo .plant-sighting-photo-status {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      min-height: 0;
    }
    /* E) Avatar — bu sahifada 36px, pastki o'ng burchakda. */
    .profile-sighting-card .sighting-user-avatar {
      width: 36px;
      height: 36px;
      right: 8px;
      bottom: 8px;
    }
    /* C) Kartochka ichi — flex column; tugmalar qatori margin-top:auto
       bilan HAR DOIM pastda (grid align-items:stretch bilan birga bir
       qatordagi barcha tugmalar bitta chiziqda). */
    .profile-sighting-body {
      display: flex;
      flex-direction: column;
      flex: 1 1 auto;
      padding: 0 12px 12px;
    }
    /* E) Tur nomi — aniq 2 qator (bir xil balandlik), ortig'i "..." bilan;
       ilmiy nom kursiv (plant_sci_name_html <i> beradi), muallif oddiy. */
    .profile-sighting-name {
      font-weight: 700;
      font-size: 13px;
      line-height: 1.3;
      color: #333;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      min-height: 34px;
      margin-bottom: 6px;
    }
    /* D) Belgilar — TASDIQLANGAN va "Ilmiy" ikkalasi ham kichik chip
       (~20px, 11px), bitta qatorda, joy yetmasa pastga. Qatorga
       min-height — belgisiz kartochka ham bir xil balandlik. */
    .profile-sighting-badges {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 4px;
      min-height: 22px;
      margin-bottom: 6px;
    }
    .profile-sighting-card .sighting-status-badge,
    .profile-sighting-rg-chip {
      display: inline-block;
      height: 20px;
      line-height: 12px;
      padding: 4px 8px;
      font-size: 11px;
      font-weight: 700;
      border-radius: 10px;
      margin: 0;
      white-space: nowrap;
    }
    .profile-sighting-rg-chip {
      background: #B4C424;
      color: #22261F;
    }
    /* F) Meta — sana, joy. Joy XOM koordinata bo'lmaydi: helper 3 xonaga
       yaxlitlaydi (3 xona), bo'sh bo'lsa qator umuman
       chiqmaydi — kartochka balandligi buzilmaydi. Koordinata
       SightingCoordinates helperidan o'tadi (himoyalangan tur sizmaydi). */
    .profile-sighting-meta {
      font-size: 11px;
      color: #888;
      line-height: 1.45;
      margin-bottom: 8px;
    }
    .profile-sighting-meta p {
      margin: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    /* G) Tugmalar (izoh / tahrirlash / o'chirish) — bitta qatorda,
       kartochka pastida, kamida 36x36px, title + aria-label bilan.
       Faqat egasi va ekspertga ko'rinadi (partial: can_manage). */
    .profile-sighting-actions {
      display: flex;
      align-items: stretch;
      gap: 4px;
      margin-top: auto;
    }
    .profile-sighting-actions.single-action {
      justify-content: flex-start;
    }
    .sighting-action-btn {
      flex: 1 1 0;
      min-width: 36px;
      min-height: 36px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      padding: 6px 4px;
      border: 1px solid #e2e2e2;
      border-radius: 8px;
      background: #f7faf3;
      color: #4a6b3a;
      text-decoration: none !important;
      cursor: pointer;
      font-size: 11px;
      font-weight: 600;
      line-height: 1;
      transition: background-color .15s ease, color .15s ease;
    }
    .sighting-action-btn:hover,
    .sighting-action-btn:focus {
      background: #eaf1e2;
      color: #046A38;
    }
    .sighting-delete-btn:hover,
    .sighting-delete-btn:focus {
      background: #fbe0e0;
      color: #a32626;
    }
    .profile-sighting-actions.single-action .sighting-action-btn {
      flex: 0 0 auto;
      min-width: 44px;
      padding-left: 14px;
      padding-right: 14px;
    }
    .sighting-action-icon {
      width: 16px;
      height: 16px;
      flex-shrink: 0;
      pointer-events: none;
    }
    .profile-sighting-card .sighting-comment-count {
      font-size: 11px;
    }
    /* H) Mobilda tab qatori (.sub-nav-pils) yashirin — "Xarita"ga
       o'tish uchun alohida havola (faqat <768px). */
    .profile-mobile-map-link {
      display: inline-block;
      margin: 4px 0 10px;
      font-weight: 700;
      color: #800020 !important;
    }
    /* I) TELEFON — 2 ustun (grid style.css.scss'da), tugmalar bosiladigan
       o'lchamda (36px saqlanadi), matn o'rniga faqat ikonka. */
    @media (max-width: 767px) {
      .profile-sighting-photo-frame { padding: 8px; }
      .profile-sighting-body { padding: 0 8px 8px; }
      .sighting-action-btn { font-size: 0; padding: 6px 2px; }
      .profile-sighting-card .sighting-comment-count { font-size: 10px; }
      .profile-sighting-actions.single-action .sighting-action-btn {
        padding-left: 10px;
        padding-right: 10px;
      }
      .profile-sighting-name { font-size: 12px; min-height: 32px; }
    }

= render 'plant_sightings/comment_modal'

.bg-btm-container
  / Content
  .container.uz-container.content
    - profile_scope = 'profile.show'
    / Content BODY
    .row.profile-container.mtop20.mbtm40.content-container
      .row.profile-info-block
        .col-md-3.col-sm-5.profile-user-data
          %h4
            =image_tag @user.avatar.thumb.url, class: 'img img-circle'
            =@user.full_name
        -if @user.subscribed?(Time.zone.now.year)
          .col-md-3.col-sm-12.profile-stat-data
            %p
              = I18n.t('.bg_amount_1', scope: profile_scope)
              =link_to "#{I18n.t('.bg_amount_2', scope: profile_scope)} - #{@big_year_species_count}", big_year_path
              %br
                = I18n.t('.rating_1', scope: profile_scope)
                =link_to "#{I18n.t('.rating_2', scope: profile_scope)} - #{@big_year_rating}", big_year_path
        .col-md-3.col-sm-12.profile-user-icons
          -if @user.expert?
            = render 'shared/expert_icon', size: 36
        -unless @user.current?(current_user)
          .col-md-3.col-sm-12.profile-follow-block
            = render 'follow_button', user: @user

      / 4-ish (H): alohida "Suratlar / Xarita" qatori olib tashlandi —
      / "Xarita" endi mavjud yorliqlar qatorida (pastda). Mobilda tab
      / qatori (.sub-nav-pils) yashirin, shuning uchun "Xarita"ga o'tish
      / uchun alohida (faqat <768px) havola.
      = link_to I18n.t('.map.tab', scope: profile_scope), user_map_path(@user), class: 'profile-mobile-map-link display-sm-only'

      .row.sub-nav-pils.mtop20.sm-display-none
        -if @user.current?(current_user)
          %a.active.profile-menu{"data-view" => "block1"}
            .menu-title
              %span
                = I18n.t('.tab_profile', scope: profile_scope)
        %a.profile-menu{"data-view" => "block2"}
          .menu-title
            %span
              #{I18n.t('.tab_species', scope: profile_scope)} [#{@species.size}]
        %a.profile-menu{"data-view" => "block3"}
          .menu-title
            %span
              = I18n.t('.tab_photo', scope: profile_scope)
            %span.profile-birds-count [#{@sightings.total_count}]
        -# "Xarita" — .profile-menu EMAS: profile.js `.profile-menu`ga
        -# preventDefault qo'yadi, bu esa haqiqiy havola (alohida sahifa).
        -# `.sub-nav-pils a` uslubi baribir qo'llanadi.
        = link_to user_map_path(@user), class: 'profile-menu-map' do
          .menu-title
            %span= I18n.t('.map.tab', scope: profile_scope)
        -if @user.current?(current_user)
          %a.profile-menu{"data-view" => "block4"}
            .menu-title
              %span
                = I18n.t('.tab_drafts', scope: profile_scope)
              %span.profile-drafts-count [#{@drafts.size}]
        %a.profile-menu{"data-view" => "block5"}
          .menu-title
            %span
              = I18n.t('.tab_comments', scope: profile_scope)
            %span.profile-comments-count [#{@comments.total_count}]
        %a.profile-menu{"data-view" => "block6"}
          .menu-title
            %span
              #{I18n.t('.tab_following', scope: profile_scope)} [#{@following.size}]
        %a.profile-menu{"data-view" => "block7"}
          .menu-title
            %span
              = I18n.t('.tab_followers', scope: profile_scope)
            %span.profile-followers-count [<span class="followers-count">#{@followers.size}</span>]

      .row.blocks-content
        -if @user.current?(current_user)
          .block-holder
            .mobile-blocks-nav
              %a.active{"data-view" => "block1"}
                %span
                  = I18n.t('.tab_profile', scope: profile_scope)
            =render 'profile'

        .block-holder
          .mobile-blocks-nav
            %a{"data-view" => "block2"}
              %span
                #{I18n.t('.tab_species', scope: profile_scope)} [#{@species.size}]
          #block2.row.profile-block-container.profile-species-block.mtop20{ :class => ('active-block' unless @user.current?(current_user)) }
            =render 'species', user_id: @user.id

        .block-holder
          .mobile-blocks-nav
            %a{"data-view" => "block3"}
              %span
                = I18n.t('.tab_photo', scope: profile_scope)
              %span.profile-birds-count [#{@sightings.total_count}]
          #block3.row.profile-block-container.profile-birds-block.mtop20
            .row
              .profile-birds-container
                =render partial: 'plant_sighting', collection: @sightings, as: :plant_sighting
              .birds-pagination.pagination-block
                =paginate @sightings, :remote => true, :param_name => 'page_sightings'

        -if @user.current?(current_user)
          .block-holder
            .mobile-blocks-nav
              %a{"data-view" => "block4"}
                %span
                  = I18n.t('.tab_drafts', scope: profile_scope)
                %span.profile-drafts-count [#{@drafts.size}]
            #block4.row.profile-block-container.profile-drafts-block.mtop20
              .row
                .profile-birds-container
                  =render partial: 'plant_sighting', collection: @drafts, as: :plant_sighting

        .block-holder
          .mobile-blocks-nav
            %a{"data-view" => "block5"}
              %span
                = I18n.t('.tab_comments', scope: profile_scope)
              %span.profile-comments-count [#{@comments.total_count}]
          #block5.row.profile-block-container.profile-comments-block.mtop20
            .row
              .comments-container
                =render 'comments'
              .comments-pagination.pagination-block
                =paginate @comments, :remote => true, :param_name => 'page_comments'

        .block-holder
          .mobile-blocks-nav
            %a{"data-view" => "block6"}
              %span
                #{I18n.t('.tab_following', scope: profile_scope)} [#{@following.size}]
          #block6.row.profile-block-container.profile-follows-block.mtop20
            = render 'follows_list', users: @following

        .block-holder
          .mobile-blocks-nav
            %a{"data-view" => "block7"}
              %span
                #{I18n.t('.tab_followers', scope: profile_scope)} [<span class="followers-count">#{@followers.size}</span>]
          #block7.row.profile-block-container.profile-follows-block.mtop20
            = render 'follows_list', users: @followers
